# Copia questo file in ".env" (cp .env.example .env) e compila i valori.
# Il file .env contiene le password: non va mai caricato su GitHub (è già escluso da .gitignore).
# Per generare una password o chiave casuale:  openssl rand -base64 32

# Indirizzo del gestionale, senza https:// (es. un sottodominio gratuito di DuckDNS)
DOMINIO=fullprojectstudio.duckdns.org

# Password del database. Va decisa PRIMA del primo avvio e poi non va più cambiata qui:
# il database la memorizza alla creazione.
DB_PASSWORD=

# Chiave segreta per i login (almeno 32 caratteri). Se la cambi, tutti devono rifare il login.
JWT_SECRET=

# Password dei due utenti, usate solo al primo avvio per crearli.
ADMIN_PASSWORD=
SEGRETERIA_PASSWORD=

# Facoltativi
ADMIN_EMAIL=admin@fullprojectstudio.it
SEGRETERIA_EMAIL=segreteria@fullprojectstudio.it
